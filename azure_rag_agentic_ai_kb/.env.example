# Azure AI Search Configuration
AZURE_SEARCH_SERVICE_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_ADMIN_KEY=your-azure-search-admin-key
AZURE_SEARCH_API_VERSION=2026-05-01-preview

# Azure OpenAI Configuration (Used for Query Planner & Answer Synthesizer)
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Execution Mode: "mock" (runs locally without Azure keys) or "azure" (connects to live Azure services)
EXECUTION_MODE=mock
