# Google Gemini / Antigravity SDK Key
GEMINI_API_KEY=your-gemini-api-key-here

# GCP Cloud Settings
GCP_PROJECT_ID=gcp-10-project
GCP_LOCATION=us-central1

# Execution Mode: "mock" (runs locally without API keys) or "live" (connects to Gemini / ADK)
EXECUTION_MODE=mock

# MCP Server Settings
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8080
