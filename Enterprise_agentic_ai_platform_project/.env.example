# ====================================================================
# Enterprise Agentic AI Platform Configuration - Local Environment Example
# ====================================================================

# 1. Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Cloud Platform Configuration
GCP_PROJECT_ID=your_gcp_project_id_here
GCP_REGION=us-central1

# 3. Application Execution Settings
PORT=8080
HOST=0.0.0.0
ENV=development
