# Google Cloud Platform Configuration
GCP_PROJECT_ID=gcp-10-project
GCP_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.0-flash-001

# Execution Mode: "mock" (runs locally without GCP keys) or "gcp" (connects to live Vertex AI)
EXECUTION_MODE=mock

# Agent Governance Configuration
GOVERNANCE_GROUNDING_THRESHOLD=0.75
GOVERNANCE_SAFETY_FILTERS=enabled
GOVERNANCE_PII_REDACTION=enabled
