# AWS Bedrock / AgentCore Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Bedrock Model Deployment ID
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Execution Mode: "mock" (runs locally without AWS account) or "aws" (connects to live AWS Bedrock)
EXECUTION_MODE=mock

# AgentCore Configuration
AGENTCORE_SESSION_TIMEOUT_SEC=1800
AGENTCORE_MEMORY_PERSISTENCE=enabled
