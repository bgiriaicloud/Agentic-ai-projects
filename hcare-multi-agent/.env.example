# =============================================================================
# HEALTHCARE MULTI-AGENT PLATFORM (GCP & ADK CONFIGURATION)
# =============================================================================

# Google Cloud Platform Core
GCP_PROJECT_ID=your-gcp-healthcare-project-id
GCP_REGION=us-central1
GCP_LOCATION=us-central1

# Gemini Enterprise Foundation Model
GEMINI_MODEL_NAME=gemini-2.0-flash-exp
GEMINI_REASONING_MODEL=gemini-2.0-pro-exp
GEMINI_API_KEY=your-gemini-api-key-or-use-workload-identity

# Google Cloud Healthcare API & FHIR Store
HEALTHCARE_DATASET_ID=hcare-production-dataset
FHIR_STORE_ID=clinical-fhir-r4-store
FHIR_VERSION=R4

# Cloud Data Loss Prevention (DLP) HIPAA De-identification
DLP_DEID_TEMPLATE_NAME=projects/your-gcp-healthcare-project-id/inspectTemplates/HIPAA-DeID-Template

# Cloud Pub/Sub & Asynchronous A2A Routing
PUBSUB_FHIR_EVENTS_TOPIC=projects/your-gcp-healthcare-project-id/topics/fhir-resource-change-events
PUBSUB_AGENT_DISPATCH_TOPIC=projects/your-gcp-healthcare-project-id/topics/hcare-agent-dispatch

# Cloud Firestore Multi-Agent State Store
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_WORKFLOW_COLLECTION=hcare_agent_workflows

# Server Configuration
PORT=8005
ENVIRONMENT=development
LOG_LEVEL=INFO
